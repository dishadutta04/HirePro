# ═══════════════════════════════════════════════════════════════
# HireFlow AI - Backend configuration (copy to backend/.env)
# ═══════════════════════════════════════════════════════════════

SECRET_KEY=your-super-secret-key-change-this-in-production

# Local SQLite by default. For Supabase Postgres use the Session pooler string from
# Supabase → Connect, e.g. postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./hrms.db

# Gemini AI (required for AI features) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: pin a model. The default alias always points at Google's current stable Flash model.
GEMINI_MODEL=gemini-flash-latest

# Supabase Auth (Project Settings → API). Leave SUPABASE_URL empty to keep the old local login.
SUPABASE_URL=https://your-project.supabase.co
# Server only, never put this in the frontend: sends invite emails and stores uploads in Supabase Storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Uploads: "auto" = private Supabase Storage bucket when the service key is set, else backend/uploads on disk.
UPLOAD_BACKEND=auto
SUPABASE_STORAGE_BUCKET=hireflow-files
# Only for projects still on the legacy JWT secret; new projects are verified through JWKS automatically.
SUPABASE_JWT_SECRET=

# Start from zero (default): no demo data; on an empty database INITIAL_ADMIN_EMAIL becomes the first admin.
# Set SEED_DEMO_DATA=true to fill an empty database with sample employees, jobs, leave and payroll instead.
SEED_DEMO_DATA=false
INITIAL_ADMIN_EMAIL=you@company.com
INITIAL_ADMIN_NAME=Your Name

# Where the frontend runs (invite links land here) and which origins may call the API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Frontend variables live in frontend/.env.local (see frontend/.env.example)
