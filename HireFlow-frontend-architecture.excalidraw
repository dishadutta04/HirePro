   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Supabase Postgres tables\n\nauth.users        (managed by Supabase Auth)\nprofiles          id = auth.users.id, role, full_name\nemployees         linked to profiles\ndocuments         file URL -> Storage bucket\njob_postings, candidates\nleave_requests, leave_balances\nattendance\nreview_cycles, performance_reviews\nonboarding_checklists, onboarding_progress\nchat_messages\npayroll_records\n\nOld 'users' table + password hashing -> replaced by Supabase Auth",
   "originalText": "Supabase Postgres tables\n\nauth.users        (managed by Supabase Auth)\nprofiles          id = auth.users.id, role, full_name\nemployees         linked to profiles\ndocuments         file URL -> Storage bucket\njob_postings, candidates\nleave_requests, leave_balances\nattendance\nreview_cycles, performance_reviews\nonboarding_checklists, onboarding_progress\nchat_messages\npayroll_records\n\nOld 'users' table + password hashing -> replaced by Supabase Auth",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "tables",
   "lineHeight": 1.25,
   "autoResize": true
  },
