   "locked": false,
   "text": "frontend/\n  middleware.ts            route + role guard\n  app/\n    (auth)/login/page.tsx\n    (dashboard)/layout.tsx  sidebar by role\n    (dashboard)/dashboard, employees,\n      recruitment, leave, attendance,\n      performance, onboarding, payroll,\n      chat, admin/users\n  lib/\n    supabase/client.ts, server.ts\n    api.ts                fetch + Bearer JWT\n  components/ui/          shadcn/ui\n  .env.local  NEXT_PUBLIC_SUPABASE_URL,\n    NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_API_URL",
   "originalText": "frontend/\n  middleware.ts            route + role guard\n  app/\n    (auth)/login/page.tsx\n    (dashboard)/layout.tsx  sidebar by role\n    (dashboard)/dashboard, employees,\n      recruitment, leave, attendance,\n      performance, onboarding, payroll,\n      chat, admin/users\n  lib/\n    supabase/client.ts, server.ts\n    api.ts                fetch + Bearer JWT\n  components/ui/          shadcn/ui\n  .env.local  NEXT_PUBLIC_SUPABASE_URL,\n    NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_API_URL",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "folders",
   "lineHeight": 1.25,
   "autoResize": true
  },
